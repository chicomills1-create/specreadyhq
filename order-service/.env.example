# SpecReady order service — environment (NAMES ONLY; values live in the host's env settings, never in this repo)
DATABASE_URL=            # Neon Postgres connection string
STRIPE_SECRET_KEY=       # restricted key, mode matches the price ids below
STRIPE_WEBHOOK_SECRET=   # signing secret for the /webhooks/stripe endpoint
STRIPE_PRICE_CAPABILITY= # price id for Capability Statement ($149)
STRIPE_PRICE_SOQ=        # price id for SOQ Package ($349)
STRIPE_PRICE_PURSUIT=    # price id for Pursuit Package ($599)
STRIPE_PRICE_UPDATE=     # price id for Update Pass ($99)
LOOKUP_SECRET=           # HMAC secret for confirmation-page status tokens
OPS_KEY=                 # shared secret for GET /queue (x-ops-key header)
SITE_URL=https://specreadyhq.com
POLICY_VERSION=v2-2026-11-01
PORT=8080
